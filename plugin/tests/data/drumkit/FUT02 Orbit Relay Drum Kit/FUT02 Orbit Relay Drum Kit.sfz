// FUT02 Orbit Relay drum kit, from Wubansia (content v1).
// sci-fi club, 130 BPM, D minor (7A). Plays the kit's drum MIDI (channel 10).
// Notes as Live and Logic name them (36 is C1). A velocity plays the nearest layer, the louder on a tie;
// round robins take turns. Levels and pans are the kit's channel faders and pans in Wubansia's mix.

<control>
default_path=Samples/

<global>
amp_veltrack=0

// 36 C1 Kick Split
<group>
key=36
loop_mode=one_shot
volume=-2
seq_length=2
<region> lovel=1 hivel=37 seq_position=1 sample=36 C1 Kick Split v1 rr1 - FUT02.wav
<region> lovel=1 hivel=37 seq_position=2 sample=36 C1 Kick Split v1 rr2 - FUT02.wav
<region> lovel=38 hivel=63 seq_position=1 sample=36 C1 Kick Split v2 rr1 - FUT02.wav
<region> lovel=38 hivel=63 seq_position=2 sample=36 C1 Kick Split v2 rr2 - FUT02.wav
<region> lovel=64 hivel=88 seq_position=1 sample=36 C1 Kick Split v3 rr1 - FUT02.wav
<region> lovel=64 hivel=88 seq_position=2 sample=36 C1 Kick Split v3 rr2 - FUT02.wav
<region> lovel=89 hivel=114 seq_position=1 sample=36 C1 Kick Split v4 rr1 - FUT02.wav
<region> lovel=89 hivel=114 seq_position=2 sample=36 C1 Kick Split v4 rr2 - FUT02.wav
<region> lovel=115 hivel=127 seq_position=1 sample=36 C1 Kick Split v5 rr1 - FUT02.wav
<region> lovel=115 hivel=127 seq_position=2 sample=36 C1 Kick Split v5 rr2 - FUT02.wav

