// FUT04 Furnace Code drum kit, from Wubansia (content v1).
// dark industrial / techno, 136 BPM, E minor (9A). Plays the kit's drum MIDI (channel 10).
// Notes as Live and Logic name them (36 is C1). A velocity plays the nearest layer, the louder on a tie;
// round robins take turns. Levels and pans are the kit's channel faders and pans in Wubansia's mix.

<control>
default_path=Samples/

<global>
amp_veltrack=0

// 35 B0 Rumble
<group>
key=35
loop_mode=loop_sustain
loop_start=0
loop_end=169411
ampeg_release=0.005
volume=-14.42
<region> lovel=1 hivel=127 sample=35 B0 Rumble - FUT04.wav

