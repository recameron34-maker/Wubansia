# LF everywhere, so checkouts are byte-identical on every platform (docs/decisions/0003).
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Golden files and the generator snapshots are compared byte for byte: never convert them.
content/golden/** -text
core/tests/snapshots/** -text

*.mid binary
*.wav binary
*.flac binary
*.zip binary

# The kits' samples are in the repo through Git LFS (ADR 0012): install git-lfs before cloning, or run
# `git lfs pull` after. CI checks out without them.
content/samples/**/*.wav filter=lfs diff=lfs merge=lfs -text
